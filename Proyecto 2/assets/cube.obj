# Simple cube OBJ model for testing
# 8 vertices, 12 triangular faces

# Vertices (cube centered at origin, size 1)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Normals
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (v/vt/vn format)
# Back face
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# Front face
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# Bottom face
f 1/1/3 5/2/3 6/3/3
f 1/1/3 6/3/3 2/4/3

# Top face
f 4/1/4 3/2/4 7/3/4
f 4/1/4 7/3/4 8/4/4

# Left face
f 1/1/5 4/2/5 8/3/5
f 1/1/5 8/3/5 5/4/5

# Right face
f 2/1/6 6/2/6 7/3/6
f 2/1/6 7/3/6 3/4/6
